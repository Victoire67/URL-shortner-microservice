# Settings profile: config.settings.dev (debug) or config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in production. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
# Docker Compose expands "$" in this file, so avoid it or wrap the value in single quotes.
SECRET_KEY=replace-with-a-long-random-string

ALLOWED_HOSTS=localhost,127.0.0.1

# docker-compose overrides this to point at its redis service
REDIS_URL=redis://localhost:6379/0
POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
LOG_LEVEL=INFO

# Production only: gunicorn worker count (defaults to 2 x CPU cores + 1)
# GUNICORN_WORKERS=4
